NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only YouTube Data API key. Enable YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=

# Optional WebRTC TURN relay for restrictive NATs/firewalls.
# Use a provider such as Cloudflare Calls, Metered, Twilio, or self-hosted coturn.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
