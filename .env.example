NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Jamendo API credential.
# Obtain your own client ID from the Jamendo developer portal.
JAMENDO_CLIENT_ID=

# Optional WebRTC TURN relay for restrictive NATs/firewalls.
# Use a provider such as Cloudflare Calls, Metered, Twilio, or self-hosted coturn.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
